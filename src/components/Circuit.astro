---
import { circuitUrl, cssLength, isValidCircuit, type CircuitOptions } from '../lib/circuit';

interface Props extends CircuitOptions {
  ctz: string;
  title?: string;
  height?: number | string;
  width?: number | string;
  lang?: string;
}

const { ctz, title = 'Interactive CircuitJS simulation', height = 640, width = '100%', lang = 'en', ...options } = Astro.props;
const valid = isValidCircuit(ctz);
const message = lang.startsWith('zh')
  ? '无法生成电路图：无效的 CircuitJS 数据格式'
  : 'Unable to render circuit: invalid CircuitJS data format';
---

{valid ? (
  <iframe
    class="circuit-frame"
    src={circuitUrl(ctz, import.meta.env.BASE_URL, options)}
    title={title}
    loading="lazy"
    style={{ width: cssLength(width), height: cssLength(height) }}
  />
) : (
  <p class="circuit-error" role="note">{message}</p>
)}

<style>
  .circuit-frame { display: block; max-width: 100%; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
  .circuit-error { padding: 1rem; border-inline-start: 3px solid var(--sl-color-orange); background: var(--sl-color-orange-low); }
</style>
